# All optional. Nothing here is required to run the site.
# Companion: POST {messages, character, knowledge} -> {reply}. Without it the local mock provider answers.
VITE_COMPANION_ENDPOINT=
# Newsletter: POST {email} -> 2xx. Without it the form is disabled and nothing is collected.
VITE_NEWSLETTER_ENDPOINT=
# Public Supabase values only (anon key). NEVER put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
